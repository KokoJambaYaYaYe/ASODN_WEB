{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/authsystem-bff/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "buffered": true
        }
      }
    ]
  },
  "ConnectionStrings": {
    "PostgresqlAuthDBConnection": "Host=${DB_HOST};Port=5432;Database=AuthSystemDB_Prod;Username=${DB_USER};Password=${DB_PASS};SSL Mode=Require;Trust Server Certificate=true;",
    "RedisConnection": "${REDIS_HOST}:6379,password=${REDIS_PASS},ssl=false,abortConnect=false"
  },
  "RedisSettings": {
    "ApplicationName": "AuthSystemBFF"
  },
  "CertificateSettings": {
    "FileName": "asodn_prod_backend.pfx",
    "PathToFile": "/etc/ssl/authsystem-bff/",
    "Password": "${CERT_PASSWORD}"
  }
}
