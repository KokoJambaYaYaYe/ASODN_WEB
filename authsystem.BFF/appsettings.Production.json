{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/auth-bff/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "ConnectionStrings": {
    "PostgresqlAuthDBConnection": "Host=${DB_HOST};Port=5432;Database=AuthSystemDB_Prod;Username=${DB_USER};Password=${DB_PASS}",
    "RedisConnection": "${REDIS_HOST}:6379,password=${REDIS_PASS},ssl=false,abortConnect=false"
  },
  "RedisSettings": {
    "ApplicationName": "AuthSystemBFF"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/modules/auth_module/{**catch-all}" },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "prod-auth": { "Address": "http://127.0.0" }
        }
      }
    }
  }
}
