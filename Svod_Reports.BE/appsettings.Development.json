{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Authentication": "Debug",
        "Microsoft.AspNetCore.DataProtection": "Verbose"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },

  "ConnectionStrings": {
    "PostgresqlAuthDBConnection": "Host=192.168.95.129;Port=5432;Database=AuthSystemDB;Username=postgres;Password=1111",
    "RedisConnection": "192.168.95.129:6379,password=1111,ssl=false,abortConnect=false"
  },

  "RedisAuthSettings": {
    "AuthApplicationName": "AuthSystemBFF"
  },

  "CertificateSettings": {
    "FileName": "asodn_backend.pfx",
    "PathToFile": "",
    "Password": "1234567890"
  }
}
